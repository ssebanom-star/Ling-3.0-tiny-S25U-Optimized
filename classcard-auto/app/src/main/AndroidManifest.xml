<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="classcard.net"/>
    </queries>
    <application
        android:theme="@style/AppTheme"
        android:label="MiMiC"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:name="net.classcardauto.mobile.BotApplication"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name="net.classcardauto.mobile.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver
            android:name="net.classcardauto.mobile.CertificationReceiver"
            android:permission="android.permission.DUMP"
            android:enabled="false"
            android:exported="true"/>
        <service
            android:label="MiMiC"
            android:name="net.classcardauto.mobile.BotService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bot_accessibility"/>
        </service>
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:exported="false"
            android:authorities="net.classcardauto.mobile.nocert.onnxruntime_telemetry_initializer"
            android:initOrder="100"/>
    </application>
</manifest>
